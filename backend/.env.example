# Application Settings
APP_NAME="AI Revenue Recovery Agent"
APP_ENV="development"
DEBUG=true
DEBUG_MODE=true
DATABASE_URL="sqlite+aiosqlite:///./recovery.db"

# LLM Configuration (LiteLLM supports Groq and Google Gemini)
GROQ_API_KEY="gsk_your_groq_api_key"
GEMINI_API_KEY="your_gemini_api_key"
LLM_MODEL="groq/openai/gpt-oss-120b"

# Razorpay API Credentials
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Twilio WhatsApp Credentials (API Key Authentication - Pre-approved Sandbox Templates)
TWILIO_API_KEY="SK_your_twilio_api_key"
TWILIO_API_SECRET="your_twilio_api_secret"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_SANDBOX_TEMPLATE="appointment" # Options: "appointment", "code", "order"

# SMTP Email Dispatcher Credentials
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM="recovery@yourbrand.com"

# Agent Guardrails
MAX_RETRY_ATTEMPTS=2
