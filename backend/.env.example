# Application Settings
APP_NAME="AI Revenue Recovery Agent"
APP_ENV="development"
DEBUG=true
DEBUG_MODE=true
DATABASE_URL="sqlite+aiosqlite:///./recovery.db"

# LLM Configuration (LiteLLM supports Groq, Google Gemini, OpenAI)
GROQ_API_KEY="gsk_your_groq_api_key"
GEMINI_API_KEY="your_gemini_api_key"
GOOGLE_API_KEY="your_gemini_api_key"
LLM_MODEL="groq/llama-3.3-70b-versatile"

# Razorpay API Credentials
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Twilio WhatsApp Credentials
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# SMTP Email Dispatcher Credentials
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM="recovery@yourbrand.com"

# Agent Guardrails
MAX_RETRY_ATTEMPTS=2
